NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://erp:erp_secret@localhost:5432/erp?schema=public

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Required in production (NODE_ENV=production) — SaaS super-admin panel auth will
# refuse to start signing/verifying tokens without this set.
JWT_SAAS_SECRET=change-me-saas-secret-min-32-chars-long

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

THROTTLE_TTL=900000
THROTTLE_LIMIT=5
